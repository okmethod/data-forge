{
  "folders": [
    {
      "name": "root",
      "path": ".",
    },
    {
      "path": "docs",
    },
    {
      "name": "pipeline",
      "path": "apps/pipeline",
    },
    {
      "name": "data",
      "path": "data",
    },
  ],
  "settings": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "prettier.requireConfig": true,
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[dockerfile]": {
      "editor.tabSize": 4,
    },
  },
}
